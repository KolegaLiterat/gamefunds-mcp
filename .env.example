# Required for HTTP transport. Generate with: gamefunds token
GAMEFUNDS_TOKEN=

# Optional read-only token (search/filter/read tools only)
GAMEFUNDS_TOKEN_READONLY=

# Per-token rate limit for owner HTTP token (default: 60/minute)
GAMEFUNDS_RATE_LIMIT=60/minute

# Higher limit for shared read-only token (default: 300/minute)
GAMEFUNDS_RATE_LIMIT_READONLY=300/minute

# Optional overrides
# GAMEFUNDS_DATA_DIR=/path/to/data   # db, guides, logs (Docker volume mount)
# GAMEFUNDS_DB_PATH=/path/to/gamefunds.db
# GAMEFUNDS_MAX_TOOL_TOKENS=2000
# GAMEFUNDS_LOG_ARGS=0
